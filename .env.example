LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# CORSで許可するオリジン（カンマ区切り）。未設定ならコード内の既定値を使う。
# ALLOWED_ORIGINS=https://yumoto-kyohei.github.io

# フロントエンドが叩くトークンAPIのベースURLはこのファイルではなく
# client/.env.production の VITE_TOKEN_SERVER_URL で設定する（ビルド時に埋め込まれる）。
